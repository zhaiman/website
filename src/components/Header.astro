---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header>
	<nav>
		<h2><a href="/">{SITE_TITLE}</a></h2>
		<div class="internal-links">
			<HeaderLink href="/">首页</HeaderLink>
			<HeaderLink href="/blog">文章</HeaderLink>
			<HeaderLink href="/archives">归档</HeaderLink>
			<HeaderLink href="/about">关于</HeaderLink>
		</div>
		<button id="theme-toggle" aria-label="切换亮色/暗色主题" title="切换主题">
			<!-- 月亮：亮色模式下显示（点击切到暗色） -->
			<svg class="icon-moon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"
				><path
					fill="currentColor"
					d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"
					stroke="currentColor"
					stroke-width="1.5"
					fill="none"
					stroke-linecap="round"
					stroke-linejoin="round"></path></svg
			>
			<!-- 太阳：暗色模式下显示（点击切到亮色） -->
			<svg class="icon-sun" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"
				><circle
					cx="12"
					cy="12"
					r="4.5"
					stroke="currentColor"
					stroke-width="1.5"
					fill="none"></circle
				><path
					stroke="currentColor"
					stroke-width="1.5"
					stroke-linecap="round"
					d="M12 2.5v2.2M12 19.3v2.2M2.5 12h2.2M19.3 12h2.2M4.9 4.9l1.6 1.6M17.5 17.5l1.6 1.6M19.1 4.9l-1.6 1.6M6.5 17.5l-1.6 1.6"></path></svg
			>
		</button>
	</nav>
</header>

<script>
	const btn = document.getElementById('theme-toggle');
	btn?.addEventListener('click', () => {
		const isDark = document.documentElement.classList.toggle('dark');
		localStorage.setItem('theme', isDark ? 'dark' : 'light');
	});
</script>

<style>
	header {
		margin: 0;
		padding: 0 1em;
		background: var(--bg-solid);
		box-shadow: 0 1px 0 rgb(var(--gray-light));
		position: sticky;
		top: 0;
		z-index: 20;
		transition: background-color 0.3s ease;
	}
	h2 {
		margin: 0;
		font-size: 1.05em;
		letter-spacing: 0.02em;
	}

	h2 a,
	h2 a.active {
		text-decoration: none;
		border-bottom: none;
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
	}
	nav a {
		padding: 1em 0.6em;
		color: rgb(var(--black));
		border-bottom: 2px solid transparent;
		text-decoration: none;
		transition:
			border-color 0.15s ease,
			color 0.15s ease;
	}
	nav a:hover {
		border-bottom-color: var(--accent);
	}
	nav a.active {
		text-decoration: none;
		border-bottom-color: var(--accent);
		font-weight: 600;
	}
	#theme-toggle {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 34px;
		height: 34px;
		padding: 0;
		background: transparent;
		border: var(--border);
		border-radius: 50%;
		color: rgb(var(--gray));
		cursor: pointer;
		transition:
			color 0.15s ease,
			border-color 0.15s ease;
	}
	#theme-toggle:hover {
		color: var(--accent);
		border-color: var(--accent);
	}
	.icon-sun {
		display: none;
	}
	:global(html.dark) .icon-sun {
		display: block;
	}
	:global(html.dark) .icon-moon {
		display: none;
	}
	@media (max-width: 720px) {
		nav a {
			padding: 0.9em 0.45em;
		}
	}
</style>
