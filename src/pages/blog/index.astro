---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';
import { readingTime } from '../../utils/posts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={`文章 · ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
		<style>
			main {
				width: 720px;
			}
			.page-title {
				margin: 0 0 1.5em 0;
			}
			.posts {
				list-style: none;
				margin: 0;
				padding: 0;
			}
			.posts li {
				padding: 1.4em 0;
				border-bottom: var(--border);
			}
			.posts li:last-child {
				border-bottom: none;
			}
			.post-title {
				margin: 0 0 0.35em 0;
				font-size: 1.25rem;
				font-weight: 600;
				line-height: 1.4;
			}
			.post-title a {
				color: rgb(var(--black));
				border-bottom: none;
			}
			.post-title a:hover {
				color: var(--accent);
			}
			.post-meta {
				display: flex;
				align-items: center;
				flex-wrap: wrap;
				gap: 0.4em;
				color: rgb(var(--gray));
				font-size: 0.85rem;
			}
			.post-meta .sep {
				opacity: 0.6;
			}
			.post-desc {
				margin: 0.5em 0 0 0;
				color: rgb(var(--gray));
				font-size: 0.92rem;
				line-height: 1.7;
			}
			.tag {
				padding: 0.1em 0.6em;
				background: var(--accent-soft);
				border-radius: 999px;
				color: rgb(var(--gray));
				font-size: 0.8rem;
			}
			.tag:hover {
				color: var(--accent);
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<h1 class="page-title">文章</h1>
			<ul class="posts">
				{
					posts.map((post) => (
						<li>
							<h2 class="post-title">
								<a href={`/blog/${post.id}/`}>{post.data.title}</a>
							</h2>
							<div class="post-meta">
								<span><FormattedDate date={post.data.pubDate} /></span>
								<span class="sep">·</span>
								<span>约 {readingTime(post.body ?? '')} 分钟</span>
								{post.data.tags.map((tag) => (
									<a class="tag" href={`/tags/${tag}/`}>
										{tag}
									</a>
								))}
							</div>
							{post.data.description && (
								<p class="post-desc">{post.data.description}</p>
							)}
						</li>
					))
				}
			</ul>
		</main>
		<Footer />
	</body>
</html>
